# Postgres
POSTGRES_USER=resq
POSTGRES_PASSWORD=resq_dev_password
POSTGRES_DB=resq
POSTGRES_PORT=5432
DATABASE_URL=postgresql://resq:resq_dev_password@localhost:5432/resq

# Redis
REDIS_PASSWORD=resq_dev_password
REDIS_PORT=6379
REDIS_URL=redis://:resq_dev_password@localhost:6379

# App
JWT_SECRET=change_me_in_production
PORT=4000

# Donor notifications (SMS via Semaphore, email via Resend)
# Leave blank to disable a channel — sends are skipped and logged as
# "failed" with a clear reason instead of crashing the broadcast flow.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
RESEND_API_KEY=
# Resend's default onboarding@resend.dev sandbox sender can only deliver to
# the email you signed up to Resend with — fine for a first smoke test, but
# it will silently fail to reach real donors. Once a domain is verified in
# Resend (Settings > Domains), point this at an address on it instead, e.g.
# "ResQ Alerts <notifications@yourdomain.com>".
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev
